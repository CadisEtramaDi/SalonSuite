@page "/booking-success"

<PageTitle>Booking Confirmation & Payment Receipt | Beauty Hair Studio</PageTitle>

<!-- Public Navigation Bar -->
<header class="public-navbar">
    <div class="container-custom navbar-inner">
        <a href="/" class="brand-logo">
            <img src="images/logo.png" alt="Beauty Hair Logo" class="brand-logo-img" />
            <span style="letter-spacing: -0.03em;">Beauty Hair</span>
        </a>

        <ul class="nav-menu-links">
            <li><a href="/" class="nav-link-item">Home</a></li>
            <li><a href="book" class="nav-link-item">Packages & Services</a></li>
            <li><a href="loyalty" class="nav-link-item">Loyalty & Rewards</a></li>
            <li><a href="/#our-work" class="nav-link-item">Portfolio</a></li>
            <li><a href="/#team" class="nav-link-item">Stylists</a></li>
        </ul>

        <div class="navbar-actions">
            <a href="book" class="btn-book-nav">
                <i class="bi bi-calendar2-check"></i> Book Another
            </a>
            @if (SalonService.CurrentUser.IsLoggedIn)
            {
                <a href="loyalty" class="btn-staff-nav">
                    <i class="bi bi-person-check-fill"></i> @SalonService.CurrentUser.Name.Split(' ').FirstOrDefault()
                </a>
            }
            <button class="mobile-nav-toggle" @onclick="() => isMobileNavOpen = !isMobileNavOpen" aria-label="Toggle navigation menu">
                <i class="bi @(isMobileNavOpen ? "bi-x-lg" : "bi-list")"></i>
            </button>
        </div>
    </div>
</header>

@if (isMobileNavOpen)
{
    <div class="mobile-nav-drawer" @onclick="() => isMobileNavOpen = false">
        <div class="mobile-nav-drawer-content" @onclick:stopPropagation>
            <a href="/" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-house"></i> Home</a>
            <a href="book" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-scissors"></i> Packages & Services</a>
            <a href="loyalty" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-stars"></i> Loyalty & Rewards</a>
            <a href="/#our-work" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-images"></i> Portfolio & Work</a>
            <a href="/#team" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-people"></i> Stylists & Specialists</a>
            <a href="/#contact" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-geo-alt"></i> Contact & Location</a>
            <div class="mobile-nav-divider"></div>
            <a href="book" class="btn-book-nav" style="justify-content: center; width: 100%;" @onclick="() => isMobileNavOpen = false">
                <i class="bi bi-calendar2-check"></i> Book Another Appointment
            </a>
            @if (SalonService.CurrentUser.IsLoggedIn)
            {
                <a href="loyalty" class="btn-staff-nav" style="justify-content: center; width: 100%; text-align: center; margin-top: 8px;" @onclick="() => isMobileNavOpen = false">
                    <i class="bi bi-person-circle"></i> My Account (@SalonService.CurrentUser.Name)
                </a>
            }
        </div>
    </div>
}

<main class="booking-page-body" style="min-height: 80vh; padding: 48px 0 64px 0; background: #FAF9F6;">
    <div class="container-custom" style="max-width: 680px;">

        @if (isVerifying)
        {
            <div style="background: #FFFFFF; border: 1px solid var(--border-light); border-radius: 12px; padding: 48px 24px; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
                <div class="spinner-border" style="width: 3rem; height: 3rem; color: #D97706;" role="status"></div>
                <h3 style="font-weight: 800; margin: 20px 0 8px 0; color: var(--text-dark);">Verifying Stripe Payment...</h3>
                <p style="color: var(--text-muted); font-size: 14px;">Confirming transaction with Stripe Sandbox gateway and securing your appointment slot.</p>
            </div>
        }
        else if (isSuccess && matchedAppt != null)
        {
            <div style="background: #FFFFFF; border: 1px solid #10B981; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.08);">
                
                <!-- Success Header Banner -->
                <div style="background: linear-gradient(135deg, #064E3B 0%, #047857 100%); color: #FFFFFF; padding: 36px 24px; text-align: center;">
                    <div style="width: 64px; height: 64px; background: rgba(255, 255, 255, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px; margin: 0 auto 16px auto; backdrop-filter: blur(8px);">
                        <i class="bi bi-check-lg" style="color: #6EE7B7;"></i>
                    </div>
                    <span style="background: rgba(110, 231, 183, 0.2); color: #A7F3D0; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 9999px; border: 1px solid rgba(167, 243, 208, 0.3);">
                        @(isSimulated ? "STRIPE SANDBOX VERIFIED" : "ONLINE PAYMENT CONFIRMED")
                    </span>
                    <h1 style="font-size: 28px; font-weight: 800; margin: 12px 0 6px 0; letter-spacing: -0.02em;">Payment Successful!</h1>
                    <p style="margin: 0; font-size: 14.5px; color: #D1FAE5; opacity: 0.9;">
                        Your appointment has been reserved and marked as <strong>Fully Paid</strong>.
                    </p>
                </div>

                <!-- Receipt Body -->
                <div style="padding: 28px 32px;">
                    
                    <!-- Appointment Reference & Status -->
                    <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px dashed var(--border-light); margin-bottom: 20px;">
                        <div>
                            <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; display: block;">Booking Reference</span>
                            <strong style="font-size: 17px; font-family: monospace; color: var(--text-dark);">#APT-@(matchedAppt.Id.ToString("D5"))</strong>
                        </div>
                        <div style="text-align: right;">
                            <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; display: block;">Payment Gateway</span>
                            <span style="background: #FEF3C7; color: #92400E; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 4px;">
                                <i class="bi bi-stripe"></i> Stripe Sandbox Card
                            </span>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-bottom: 24px;">
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Client Name</span>
                            <strong style="font-size: 14px; color: var(--text-dark);">@matchedAppt.ClientName</strong>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Contact Phone</span>
                            <strong style="font-size: 14px; color: var(--text-dark);">@matchedAppt.ClientPhone</strong>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Service Ritual</span>
                            <strong style="font-size: 14px; color: #D97706;">@matchedAppt.ServiceName</strong>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Dedicated Stylist</span>
                            <strong style="font-size: 14px; color: var(--text-dark);">@matchedAppt.StylistName</strong>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Date & Time</span>
                            <strong style="font-size: 14px; color: var(--text-dark);">@matchedAppt.Date.ToString("MMM dd, yyyy") &bull; @matchedAppt.TimeSlot</strong>
                        </div>
                        <div>
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 2px;">Booking Status</span>
                            @if (matchedAppt.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="background: #FEE2E2; color: #991B1B; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 4px; display: inline-block;">
                                    <i class="bi bi-x-circle-fill"></i> Cancelled
                                </span>
                            }
                            else
                            {
                                <span style="background: #ECFDF5; color: #065F46; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 4px; display: inline-block;">
                                    <i class="bi bi-check2-circle"></i> Paid & Confirmed
                                </span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(cancelSuccessFeedback))
                    {
                        <div style="background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-info-circle-fill" style="color: #DC2626;"></i>
                            <span>@cancelSuccessFeedback</span>
                        </div>
                    }

                    <!-- Payment Summary Breakdown -->
                    <div style="background: #F9FAFB; border: 1px solid var(--border-light); border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 8px; color: var(--text-dark);">
                            <span>@matchedAppt.ServiceName</span>
                            <span>₱@matchedAppt.Price.ToString("N0")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 8px; color: #059669; font-weight: 600;">
                            <span><i class="bi bi-gift-fill"></i> Loyalty Points Credited</span>
                            <span>+@((int)(matchedAppt.Price / 100)) pts</span>
                        </div>
                        <div style="border-top: 1px solid var(--border-light); padding-top: 10px; display: flex; justify-content: space-between; align-items: baseline;">
                            <span style="font-weight: 800; font-size: 15px; color: var(--text-dark);">Total Amount Charged</span>
                            <span style="font-weight: 900; font-size: 20px; color: #047857;">₱@matchedAppt.Price.ToString("N0")</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <a href="loyalty?appt_id=@matchedAppt.Id" class="btn-primary-dark" style="flex: 1; text-align: center; justify-content: center; text-decoration: none;">
                            <i class="bi bi-gem"></i> View in Loyalty Lounge
                        </a>
                        <a href="book" class="btn-cancel-modal" style="flex: 1; text-align: center; justify-content: center; text-decoration: none; border: 1px solid var(--border-light);">
                            <i class="bi bi-calendar-plus"></i> Book Another Ritual
                        </a>
                        @if (!matchedAppt.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn-cancel-appt-action" style="flex: 1; justify-content: center; padding: 11px 16px; border-radius: 8px; font-weight: 700; font-size: 13px; border: 1px solid #FCA5A5; background: #FEF2F2; color: #DC2626; cursor: pointer; display: flex; align-items: center; gap: 6px;" @onclick="PromptCancelReceiptAppt">
                                <i class="bi bi-x-circle"></i> Cancel Appointment
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (showCancelModal)
            {
                <div class="booking-modal-backdrop" @onclick="AbortCancelReceiptAppt">
                    <div class="booking-modal-card" style="max-width: 480px; padding: 28px; border-radius: 14px;" @onclick:stopPropagation>
                        <div style="text-align: center; margin-bottom: 20px;">
                            <div style="width: 56px; height: 56px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 12px auto; border: 2px solid #FDE68A;">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>
                            <h3 style="font-size: 20px; font-weight: 800; color: var(--text-dark); margin: 0 0 6px 0;">Cancel Paid Appointment?</h3>
                            <p style="font-size: 13.5px; color: var(--text-muted); margin: 0;">
                                Are you sure you want to cancel booking <strong>#APT-@matchedAppt.Id.ToString("D5")</strong>?
                            </p>
                        </div>

                        <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 12.5px; color: #92400E;">
                            <i class="bi bi-info-circle-fill"></i> This appointment was paid online. Upon cancellation, your reserved slot will be freed and our reception desk will process your refund to the original payment method.
                        </div>

                        <div style="margin-bottom: 20px; text-align: left;">
                            <label style="font-size: 12px; font-weight: 700; color: var(--text-dark); display: block; margin-bottom: 6px;">
                                Reason for cancellation (optional):
                            </label>
                            <select class="booking-input" style="font-size: 13.5px; width: 100%;" @bind="cancelReason">
                                <option value="Change of schedule">Change of schedule / Conflict</option>
                                <option value="Booked incorrect date or time">Booked incorrect date or time</option>
                                <option value="Need to choose a different service">Need to choose a different service</option>
                                <option value="Personal emergency">Personal emergency</option>
                                <option value="Other reasons">Other reasons</option>
                            </select>
                        </div>

                        <div style="display: flex; gap: 10px;">
                            <button type="button" class="btn-cancel-modal" style="flex: 1; justify-content: center; border: 1px solid var(--border-light); font-weight: 600;" @onclick="AbortCancelReceiptAppt" disabled="@isCancelling">
                                No, Keep It
                            </button>
                            <button type="button" class="btn-primary-dark" style="flex: 1; justify-content: center; background: #DC2626; border-color: #DC2626; color: #FFF; font-weight: 700;" @onclick="ConfirmCancelReceiptAppointment" disabled="@isCancelling">
                                @if (isCancelling)
                                {
                                    <span><i class="bi bi-arrow-repeat spin"></i> Processing...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-trash3-fill"></i> Yes, Cancel</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="background: #FFFFFF; border: 1px solid #EF4444; border-radius: 12px; padding: 40px 24px; text-align: center; box-shadow: 0 4px 20px rgba(239, 68, 68, 0.08);">
                <div style="width: 56px; height: 56px; background: #FEE2E2; color: #DC2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px auto;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 style="font-weight: 800; color: #991B1B; margin-bottom: 8px;">Payment Verification Notice</h3>
                <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;">
                    @(errorMessage ?? "We could not verify the Stripe checkout session. If you completed payment, our reception staff will confirm your slot upon arrival.")
                </p>
                <div style="display: flex; gap: 12px; justify-content: center;">
                    <a href="book" class="btn-primary-dark" style="text-decoration: none;">Return to Booking</a>
                    <a href="/" class="btn-cancel-modal" style="text-decoration: none; border: 1px solid var(--border-light);">Return Home</a>
                </div>
            </div>
        }
    </div>
</main>

