                                                        class="btn-primary-dark" 
                                                        style="flex: 1; background: linear-gradient(135deg, #005CE6 0%, #007DFE 100%); border: none; justify-content: center; font-size: 14px; font-weight: 700; padding: 12px; border-radius: 8px; min-width: 200px;" 
                                                        @onclick="GenerateGcashQrCode" 
                                                        disabled="@(!HasSelectedAwaitingPayment || isProcessingGcash || string.IsNullOrWhiteSpace(billingClientName) || netTotalDue <= 0)">
                                                    @if (isProcessingGcash)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 6px;"></span>
                                                        <span>Generating QR...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-qr-code"></i>
                                                        <span>Show GCash QR (₱@netTotalDue.ToString("N0"))</span>
                                                    }
