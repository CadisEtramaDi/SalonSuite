@page "/cashier"
@page "/pos"

<PageTitle>Front Desk POS, Floor & Billing | Beauty Hair Studio</PageTitle>

<div class="portal-layout">
    <!-- Dark POS Sidebar -->
    <aside class="portal-sidebar">
        <div class="portal-brand-block" style="display: flex; align-items: center; gap: 10px; padding: 0 4px 14px; border-bottom: 1px solid var(--border-dark); margin-bottom: 12px;">
            <img src="images/logo.png" alt="Beauty Hair Logo" class="sidebar-logo-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-bottom: 0; border: 1.5px solid var(--gold-accent); flex-shrink: 0;" />
            <div style="display: flex; flex-direction: column; justify-content: center; min-width: 0; line-height: 1.2;">
                <span style="font-size: 15px; font-weight: 800; color: #FFFFFF; letter-spacing: 0.04em; white-space: nowrap;">BEAUTY HAIR</span>
                <span style="font-size: 10px; font-weight: 700; color: #F59E0B; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; margin-top: 2px;">
                </span>
            </div>
        </div>

        <div class="portal-nav-scroll">
            <div class="portal-group-label">FRONT DESK & POS</div>
            <button class="portal-nav-btn @(currentTab == "register" ? "active" : "")" @onclick='() => currentTab = "register"'>
                <i class="bi bi-calculator"></i> POS Checkout Register
            </button>
            <button class="portal-nav-btn @(currentTab == "floor" ? "active" : "")" @onclick='() => currentTab = "floor"'>
                <i class="bi bi-display"></i> Floor & Chair Queue
                @if (ActiveChairsCount > 0)
                {
                    <span style="background: #3B82F6; color: #FFF; font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 10px; margin-left: auto;">
                        @ActiveChairsCount Seated
                    </span>
                }
            </button>
            <button class="portal-nav-btn @(currentTab == "roster" ? "active" : "")" @onclick='() => currentTab = "roster"'>
                <i class="bi bi-people-fill"></i> Stylist Roster & Comm.
            </button>
            <button class="portal-nav-btn @(currentTab == "checkin" ? "active" : "")" @onclick='() => currentTab = "checkin"'>
                <i class="bi bi-person-check"></i> Walk-in Check-in
            </button>
            <button class="portal-nav-btn @(currentTab == "invoices" ? "active" : "")" @onclick='() => currentTab = "invoices"'>
                <i class="bi bi-receipt"></i> Daily Invoices & Ledger
            </button>
        </div>

        <div class="portal-user-footer">
            <div>
                <span class="portal-user-name">@(SalonService.CurrentUser.IsLoggedIn ? SalonService.CurrentUser.Name : "Clara Santos")</span>
                <span class="portal-user-role" style="color: #FBBF24;">@(SalonService.CurrentUser.IsLoggedIn ? SalonService.CurrentUser.Role : "Cashier / Front Desk")</span>
            </div>
            <button class="btn-logout-icon" title="Logout" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </aside>

    <!-- Main POS Content Panel -->
    <main class="portal-main-body">
        <!-- Top Bar -->
        <div class="portal-top-bar">
            <div>
                <h1 class="portal-page-heading">
                    @(currentTab switch
                    {
                        "register" => "Point of Sale & Billing Register",
                        "floor" => "Salon Floor & Chair Queue Monitor",
                        "roster" => "Stylist Availability & Commission Ledger",
                        "invoices" => "Daily Invoices & Receipts Archive",
                        "checkin" => "Client Front Desk Check-in",
                        _ => "Front Desk Terminal"
                    })
                </h1>
                <p style="color: var(--text-muted); font-size: 14px;">Cashier Station #01 &bull; Centralized floor control, stylist management & live billing</p>
            </div>

            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">

                @if (currentTab != "register")
                {
                    <button class="btn-primary-dark" style="background: #10B981;" @onclick='() => currentTab = "register"'>
                        <i class="bi bi-calculator"></i> Open POS Register
                    </button>
                }
                <button class="btn-primary-dark" @onclick='() => currentTab = "checkin"'>
                    <i class="bi bi-person-check"></i> Walk-in Check-in
                </button>
            </div>
        </div>

        <!-- POS KPI Grid -->
        <div class="portal-kpi-grid">
            <div class="portal-kpi-card">
                <span class="portal-kpi-label">Today's Collections</span>
                <div class="portal-kpi-num" style="color: #10B981;">₱@SalonService.Invoices.Sum(i => i.Total).ToString("N0")</div>
            </div>
            <div class="portal-kpi-card">
                <span class="portal-kpi-label">Active Chairs Seated</span>
                <div class="portal-kpi-num" style="color: #3B82F6;">@ActiveChairsCount</div>
            </div>
            <div class="portal-kpi-card">
                <span class="portal-kpi-label">Pending Checkout</span>
                <div class="portal-kpi-num" style="color: #F59E0B;">@SalonService.Appointments.Count(a => a.Status == "Completed" && !a.IsPaid)</div>
            </div>
            <div class="portal-kpi-card">
                <span class="portal-kpi-label">Invoices Issued</span>
                <div class="portal-kpi-num">@SalonService.Invoices.Count</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(successNotification))
        {
            <div style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 14px 18px; border-radius: 4px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <i class="bi bi-check-circle-fill"></i> <strong>Success!</strong> @successNotification
                </div>
                <div style="display: flex; gap: 8px;">
                    @if (lastPaidInvoice != null)
                    {
                        <button style="background: #065F46; color: #FFFFFF; border: none; padding: 6px 12px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer;" @onclick="() => OpenReceiptModal(lastPaidInvoice!)">
                            <i class="bi bi-printer"></i> View Receipt
                        </button>
                    }
                    <button style="border: none; background: transparent; color: #065F46; font-size: 18px; cursor: pointer;" @onclick='() => successNotification = null'>&times;</button>
                </div>
            </div>
        }

        <!-- ============================================================== -->
        <!-- TAB 1: POS Register                                            -->
        <!-- ============================================================== -->
        @if (currentTab == "register")
        {
            <div style="display: grid; grid-template-columns: 1.1fr 1.4fr; gap: 24px; align-items: start;">
                <!-- Left: Queue of appointments ready for billing -->
                <div class="portal-data-card" style="margin-bottom: 0;">
                    <div class="portal-card-header">
                        <div>
                            <h3 class="portal-card-title">1. Select Appointment to Bill</h3>
                            <span style="font-size: 12px; color: var(--text-muted);">Completed rituals ready for checkout</span>
                        </div>
                        <span style="font-size: 12px; background: #FEF3C7; color: #92400E; padding: 4px 8px; border-radius: 4px; font-weight: 700;">
                            @SalonService.Appointments.Count(a => a.Status == "Completed" && !a.IsPaid) Ready to Bill
                        </span>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var appt in SalonService.Appointments.Where(a => a.Status == "Completed" && !a.IsPaid).OrderByDescending(a => a.Id))
                        {
                            bool isSelected = selectedApptId == appt.Id;
                            <div style="border: 2px solid @(isSelected ? "var(--gold-accent)" : "var(--border-light)"); padding: 14px; border-radius: 4px; cursor: pointer; background: @(isSelected ? "#FFFDF5" : "#FFFFFF"); transition: all 0.2s ease;"
                                 @onclick="() => SelectAppointmentForBilling(appt)">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <strong style="font-size: 15px;">@appt.ClientName</strong>
                                    <span style="font-weight: 800; color: var(--gold-accent); font-size: 15px;">₱@appt.Price.ToString("N0")</span>
                                </div>
                                <div style="font-size: 13px; color: var(--text-muted); display: flex; justify-content: space-between;">
                                    <span><i class="bi bi-scissors"></i> @appt.ServiceName</span>
                                    <span><i class="bi bi-person"></i> @appt.StylistName</span>
                                </div>
                                <div style="margin-top: 8px; display: flex; justify-content: space-between; align-items: center;">
                                    <span class="badge-status completed">Ritual Done</span>
                                    <span style="font-size: 12px; color: var(--text-muted);">Slot: @appt.TimeSlot</span>
                                </div>
                            </div>
                        }

                        @if (!SalonService.Appointments.Any(a => a.Status == "Completed" && !a.IsPaid))
                        {
                            <div style="text-align: center; padding: 36px 20px; color: var(--text-muted); background: #FAF9F6; border: 1px dashed var(--border-light); border-radius: 6px;">
                                <i class="bi bi-hourglass-split" style="font-size: 28px; color: var(--gold-accent);"></i>
                                <p style="margin: 8px 0 2px 0; font-weight: 700; color: var(--text-dark);">No Completed Rituals Awaiting Payment</p>
                                <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 12px 0;">Clients will appear here once the specialist clicks <strong>'Finish Ritual (Done)'</strong>.</p>
                                <button class="btn-primary-dark" style="font-size: 12px; padding: 8px 14px;" @onclick='() => currentTab = "checkin"'>
                                    <i class="bi bi-person-check"></i> Walk-in Check-in
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Interactive POS Billing Register -->
                <div class="portal-data-card" style="margin-bottom: 0; background: #FFFFFF; border: 1px solid var(--border-light);">
                    <div class="portal-card-header" style="border-bottom: 1px solid var(--border-light); padding-bottom: 12px;">
                        <div>
                            <h3 class="portal-card-title">2. Billing Terminal</h3>
                            <span style="font-size: 12px; color: var(--text-muted);">Calculate discounts, add-ons, and payment</span>
                        </div>
                        @if (HasSelectedAwaitingPayment && SelectedAppointment != null)
                        {
                            <span style="font-size: 12px; font-weight: 700; color: #10B981; background: #ECFDF5; padding: 4px 8px; border-radius: 4px;">
                                TICKET #@SelectedAppointment.Id ACTIVE
                            </span>
                        }
                        else if (HasAwaitingPayments)
                        {
                            <span style="font-size: 12px; font-weight: 700; color: #D97706; background: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                SELECT TICKET
                            </span>
                        }
                        else
                        {
                            <span style="font-size: 12px; font-weight: 700; color: #6B7280; background: #F3F4F6; padding: 4px 8px; border-radius: 4px;">
                                STANDBY &bull; NO AWAITING PAYMENT
                            </span>
                        }
                    </div>

                    @if (!HasAwaitingPayments)
                    {
                        <!-- Standby State: No appointments awaiting payment -->
                        <div style="padding: 48px 24px; text-align: center;">
                            <div style="width: 64px; height: 64px; background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                                <i class="bi bi-shield-check" style="font-size: 30px; color: var(--gold-accent);"></i>
                            </div>
                            <h4 style="font-size: 17px; font-weight: 800; color: var(--text-dark); margin: 0 0 8px 0;">No Rituals Awaiting Payment</h4>
                            <p style="font-size: 13.5px; color: var(--text-muted); max-width: 440px; margin: 0 auto 20px auto; line-height: 1.5;">
                                The billing register is on standby. Payment can only be tendered once a specialist marks a client's ritual as completed on the floor.
                            </p>
                            <div style="background: #F9FAFB; border: 1px solid var(--border-light); border-radius: 6px; padding: 14px 18px; max-width: 440px; margin: 0 auto 24px auto; text-align: left; font-size: 12.5px; color: var(--text-muted);">
                                <strong style="color: var(--text-dark); display: block; margin-bottom: 6px;">Salon Floor Lifecycle:</strong>
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <span>1. <strong>Check-in</strong> &bull; Client arrives or checks in at reception</span>
                                    <span>2. <strong>In Progress</strong> &bull; Specialist seats client and performs ritual</span>
                                    <span>3. <strong>Ritual Done</strong> &bull; Specialist completes service on floor</span>
                                    <span>4. <strong>Checkout</strong> &bull; Ticket unlocks here for tender settlement</span>
                                </div>
                            </div>
                            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                                <button class="btn-primary-dark" style="font-size: 13px; padding: 9px 18px;" @onclick='() => currentTab = "floor"'>
                                    <i class="bi bi-display"></i> View Salon Floor & Queue
                                </button>
                                <button style="background: #FFFFFF; border: 1px solid var(--border-light); padding: 9px 18px; border-radius: 4px; font-weight: 700; font-size: 13px; color: var(--text-dark); cursor: pointer;" @onclick='() => currentTab = "checkin"'>
                                    <i class="bi bi-person-check"></i> Walk-in Check-in
                                </button>
                            </div>
                        </div>
                    }
                    else if (!HasSelectedAwaitingPayment)
                    {
                        <!-- Awaiting Selection State -->
                        <div style="padding: 48px 24px; text-align: center;">
                            <div style="width: 64px; height: 64px; background: #FEF3C7; border: 1px solid #FDE68A; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                                <i class="bi bi-hand-index-thumb" style="font-size: 28px; color: #D97706;"></i>
                            </div>
                            <h4 style="font-size: 17px; font-weight: 800; color: var(--text-dark); margin: 0 0 8px 0;">Select a Ticket to Proceed</h4>
                            <p style="font-size: 13.5px; color: var(--text-muted); max-width: 420px; margin: 0 auto 20px auto; line-height: 1.5;">
                                There are <strong>@SalonService.Appointments.Count(a => a.Status == "Completed" && !a.IsPaid)</strong> completed ritual(s) ready for billing. Please click an appointment from the queue on the left to review invoice details and tender payment.
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Active Billing Form for Selected Awaiting Payment Ticket -->
                        <div style="padding: 16px 0;">
                            <!-- Active Ticket Info Banner -->
                            <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                                <div>
                                    <span style="font-size: 11px; font-weight: 800; color: #166534; text-transform: uppercase; letter-spacing: 0.04em;">
                                        <i class="bi bi-check2-circle"></i> COMPLETED RITUAL READY FOR PAYMENT
                                    </span>
                                    <div style="font-size: 15px; font-weight: 800; color: #14532D; margin-top: 2px;">
                                        @SelectedAppointment!.ClientName &bull; @SelectedAppointment.ServiceName
                                    </div>
                                    <div style="font-size: 12px; color: #15803D; margin-top: 2px;">
                                        Specialist: <strong>@SelectedAppointment.StylistName</strong> &bull; Slot: <strong>@SelectedAppointment.TimeSlot</strong>
                                    </div>
                                </div>
                                <span style="font-size: 18px; font-weight: 900; color: #15803D;">
                                    ₱@SelectedAppointment.Price.ToString("N0")
                                </span>
                            </div>

                            <!-- Client & Service Info -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                                <div>
                                    <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px;">Client Name</label>
                                    <input type="text" class="booking-input" @bind="billingClientName" @bind:after="OnClientNameChanged" placeholder="Client Name" />
                                </div>
                                <div>
                                    <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px;">Assigned Stylist</label>
                                    <select class="booking-input" @bind="billingStylistName">
                                        @foreach (var tm in SalonService.Stylists)
                                        {
                                            <option value="@tm.Name">@tm.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Customer Loyalty Status Banner -->
                            @if (matchedCustomer != null)
                            {
                                <div style="background: #FAF5FF; border: 1px solid #E9D5FF; padding: 10px 14px; border-radius: 4px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <span style="font-size: 11px; font-weight: 800; color: #7C3AED; text-transform: uppercase;">CRM CLIENT: @matchedCustomer.FullName</span>
                                        <div style="font-size: 12px; color: var(--text-dark);">
                                            Tier: <strong>@matchedCustomer.Tier</strong> &bull; Points: <strong style="color: #D97706;">@matchedCustomer.LoyaltyPoints pts</strong>
                                        </div>
                                    </div>
                                    @if (matchedCustomer.LoyaltyPoints >= 200 && !redeemPoints)
                                    {
                                        <button type="button" style="background: #7C3AED; color: #FFF; border: none; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer;" @onclick="ToggleRedeemPoints">
                                            Redeem 200 pts (-₱350)
                                        </button>
                                    }
                                    else if (redeemPoints)
                                    {
                                        <span style="color: #059669; font-weight: 700; font-size: 12px;">
                                            <i class="bi bi-check-circle-fill"></i> 200 pts Redeemed (-₱350)
                                        </span>
                                    }
                                </div>
                            }

                            <div style="margin-bottom: 16px;">
                                <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px;">Selected Ritual / Service</label>
                                <select class="booking-input" @bind="billingServiceName" @bind:after="RecalculateBasePrice">
                                    <optgroup label="Service Packages">
                                        @foreach (var pkg in SalonService.Packages)
                                        {
                                            <option value="@($"{pkg.Name} Package")">@pkg.Name Package (₱@pkg.Price.ToString("N0"))</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Individual Services">
                                        @foreach (var svc in SalonService.Services)
                                        {
                                            <option value="@($"{svc.Number} {svc.Name}")">@svc.Number @svc.Name (₱@svc.Price.ToString("N0"))</option>
                                        }
                                    </optgroup>
                                </select>
                            </div>

                            <!-- Dynamic Retail Product Add-ons from Inventory -->
                            <div style="margin-bottom: 16px;">
                                <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 6px;">
                                    Add-on Salon Retail Products (Live Inventory)
                                </label>
                                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                    @foreach (var prod in SalonService.Products.Where(p => p.Category == "Retail" || p.Category == "Hair Care"))
                                    {
                                        bool isSelected = selectedProductIds.Contains(prod.Id);
                                        <button type="button" class="btn-addon @(isSelected ? "selected" : "")" @onclick="() => ToggleProductSelection(prod.Id)">
                                            <i class="bi @(isSelected ? "bi-check-square-fill" : "bi-square")"></i>
                                            @prod.Name (+₱@prod.RetailPrice.ToString("N0"))
                                            <span style="font-size: 11px; opacity: 0.8; margin-left: 4px;">[@prod.StockQuantity in stock]</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Promo Code Input & Standard Discounts -->
                            <div style="margin-bottom: 16px;">
                                <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 6px;">Promo Code / Voucher</label>
                                <div style="display: flex; gap: 8px;">
                                    <input type="text" class="booking-input" style="font-family: monospace; text-transform: uppercase; font-weight: 700;" placeholder="e.g. WELCOME10, VIP200" @bind="promoCodeInput" />
                                    <button type="button" class="btn-primary-dark" style="padding: 0 16px;" @onclick="ApplyPromoCode">Apply</button>
                                </div>
                                @if (!string.IsNullOrEmpty(promoMessage))
                                {
                                    <div style="font-size: 12px; margin-top: 4px; color: @(promoApplied ? "#059669" : "#DC2626"); font-weight: 600;">
                                        <i class="bi @(promoApplied ? "bi-check-circle" : "bi-exclamation-circle")"></i> @promoMessage
                                    </div>
                                }
                            </div>

                            <!-- Quick Discounts -->
                            <div style="margin-bottom: 20px;">
                                <label style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 6px;">Standard Discounts</label>
                                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                                    <button type="button" class="btn-discount @(selectedDiscountType == "NONE" ? "active" : "")" @onclick='() => SetDiscount("NONE")'>None (0%)</button>
                                    <button type="button" class="btn-discount @(selectedDiscountType == "SENIOR" ? "active" : "")" @onclick='() => SetDiscount("SENIOR")'>Senior (20%)</button>
                                    <button type="button" class="btn-discount @(selectedDiscountType == "VIP" ? "active" : "")" @onclick='() => SetDiscount("VIP")'>VIP (10%)</button>
                                </div>
                            </div>

                            <!-- Price Calculation Summary Box -->
                            <div style="background: #F9FAFB; border: 1px solid var(--border-light); border-radius: 4px; padding: 14px; margin-bottom: 20px;">
                                <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px;">
                                    <span style="color: var(--text-muted);">Base Service:</span>
                                    <span>₱@baseServicePrice.ToString("N0")</span>
                                </div>
                                @if (addonTotal > 0)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px;">
                                        <span style="color: var(--text-muted);">Retail Add-ons (@selectedProductIds.Count items):</span>
                                        <span>+₱@addonTotal.ToString("N0")</span>
                                    </div>
                                }
                                @if (calculatedDiscount > 0)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px; color: #DC2626;">
                                        <span>Standard Discount (@selectedDiscountType):</span>
                                        <span>-₱@calculatedDiscount.ToString("N0")</span>
                                    </div>
                                }
                                @if (promoDiscount > 0)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px; color: #DC2626;">
                                        <span>Promo Code (@promoCodeApplied):</span>
                                        <span>-₱@promoDiscount.ToString("N0")</span>
                                    </div>
                                }
                                @if (loyaltyDiscount > 0)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 6px; color: #7C3AED;">
                                        <span>Loyalty Points Redemption:</span>
                                        <span>-₱@loyaltyDiscount.ToString("N0")</span>
                                    </div>
                                }
                                <div style="border-top: 1px dashed var(--border-light); margin-top: 8px; padding-top: 8px; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <strong style="font-size: 16px;">Total Due:</strong>
                                        <span style="display: block; font-size: 11px; color: #059669; font-weight: 700;">+@((int)(netTotalDue / 100)) Loyalty Pts to Earn</span>
                                    </div>
