                                            <span>Opening Stripe Checkout...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-credit-card-2-front-fill"></i>
                                            <span>Proceed to Stripe Checkout (₱@netTotalDue.ToString("N0"))</span>
                                        }
                                    </button>
                                </div>
                            }

                            @if (selectedPaymentMethod != "Credit Card" && selectedPaymentMethod != "GCash")
                            {
                                <button class="btn-primary-dark" style="width: 100%; justify-content: center; padding: 14px; font-size: 16px;" @onclick="ProcessPayment" disabled="@(!HasSelectedAwaitingPayment || string.IsNullOrWhiteSpace(billingClientName) || netTotalDue < 0)">
                                    <i class="bi bi-check2-circle"></i> Complete Payment & Issue Receipt (₱@netTotalDue.ToString("N0"))
                                </button>
                            }
