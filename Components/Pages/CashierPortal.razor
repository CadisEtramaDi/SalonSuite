                                                <div>
                                                    <label style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; display: block; margin-bottom: 4px;">GCash Ref / Counter QR (Optional)</label>
                                                    <input type="text" class="booking-input" style="font-size: 13px; padding: 8px 12px; background: #F8FAFC;" placeholder="e.g. 902183921820" @bind="gcashReferenceNumber" />
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(gcashErrorMessage))
                                            {
                                                <div style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 12px; padding: 10px 14px; border-radius: 6px; margin-bottom: 14px;">
                                                    <i class="bi bi-exclamation-circle-fill"></i> @gcashErrorMessage
                                                </div>
                                            }

                                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
