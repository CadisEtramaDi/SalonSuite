                                            <!-- Centered QR Container with Logo Overlay -->
                                            <div style="position: relative; padding: 14px; background: #FFFFFF; border-radius: 16px; border: 2px solid #DBEAFE; box-shadow: 0 10px 25px rgba(0, 125, 254, 0.08); margin-bottom: 16px; display: inline-block;">
                                                <img src="@activeGcashQrUrl" alt="GCash Dynamic QR" style="width: 200px; height: 200px; display: block; border-radius: 6px; object-fit: contain;" />
