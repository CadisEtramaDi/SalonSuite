                                    @if (!string.IsNullOrEmpty(stripeErrorMessage))
                                    {
                                        <div style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 12px; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px;">
