<!-- Service Packages -->
<section class="packages-section" id="packages">
    <div class="container-custom">
        <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px;">
            <div>
                <span class="section-tag">PACKAGES</span>
                <h2 class="section-title" style="margin-bottom: 0;">Service Packages</h2>
            </div>
            <a href="book" class="btn-link-arrow" style="font-size: 14px; font-weight: 700;">
                Compare All Packages &rarr;
            </a>
        </div>

        <div class="packages-grid">
            @foreach (var pkg in SalonService.Packages)
            {
                <div class="package-card @(pkg.IsPopular ? "package-popular" : "")">
                    @if (pkg.IsPopular)
                    {
                        <span class="popular-badge-gold">POPULAR</span>
                    }

                    <span class="package-tier-name">@pkg.Name</span>
                    <div class="package-price-huge">@pkg.PriceFormatted</div>

                    <ul class="package-features-list">
                        @foreach (var f in pkg.Features)
                        {
                            <li class="package-feature-item">
                                <span class="feature-dot"></span>
                                <span>@f</span>
                            </li>
                        }
                    </ul>

                    <a href="@($"book?select={Uri.EscapeDataString(pkg.Name)}")" class="btn-select-package" style="display: block; text-align: center;">
                        Select Package
                    </a>
                </div>
            }
        </div>
    </div>
</section>

