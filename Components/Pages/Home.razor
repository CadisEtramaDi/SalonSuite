@page "/"
@inject SalonDataService SalonService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Salon Studio | Professional Hair Care & Styling</PageTitle>

<!-- Public Navigation Bar -->
<header class="public-navbar">
    <div class="container-custom navbar-inner">
        <a href="/" class="brand-logo">
            <img src="images/logo.png" alt="Beauty Hair Logo" class="brand-logo-img" />
            <span>Beauty Hair</span>
        </a>

        <ul class="nav-menu-links">
            <li><a href="book" class="nav-link-item">Packages & Services</a></li>
            <li><a href="loyalty" class="nav-link-item">Loyalty & Rewards</a></li>
            <li><a href="#our-work" class="nav-link-item">Our Work</a></li>
            <li><a href="#team" class="nav-link-item">Team</a></li>
            <li><a href="#contact" class="nav-link-item">Contact</a></li>
        </ul>

        <div class="navbar-actions">
            <a href="book" class="btn-book-nav">Book Appointment</a>
            <a href="login" class="btn-staff-nav">Login</a>
        </div>
    </div>
</header>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container-custom hero-grid">
        <div class="hero-text-col">
            <h1 class="hero-title">Styling</h1>
            <p class="hero-desc">
                Experience professional hair care in a serene, minimalist environment. Our expert stylists deliver exceptional results tailored to you.
            </p>
            <div class="hero-cta-group">
                <a href="book" class="btn-primary-dark">
                    <span>Book Appointment</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
                <a href="book" class="btn-link-arrow">View All Packages & Services &rarr;</a>
            </div>

            <div class="hero-stats-row">
                <div class="stat-item-col">
                    <span class="stat-huge">15+</span>
                    <span class="stat-label-muted">Years</span>
                </div>
                <div class="stat-item-col">
                    <span class="stat-huge">8K+</span>
                    <span class="stat-label-muted">Clients</span>
                </div>
                <div class="stat-item-col">
                    <span class="stat-huge">4.9</span>
                    <span class="stat-label-muted">Rating</span>
                </div>
            </div>
        </div>

        <div class="hero-image-col">
            <div class="hero-slideshow-container" 
                 @onmouseenter="() => isHovered = true" 
                 @onmouseleave="() => isHovered = false">
                
                <!-- Slides Track -->
                <div class="hero-slides-track">
                    @for (int i = 0; i < heroSlides.Count; i++)
                    {
                        var slide = heroSlides[i];
                        bool isActive = (i == currentSlideIndex);
                        <div class="hero-slide-item @(isActive ? "active" : "")">
                            <img src="@slide.ImageUrl" alt="@slide.Title" class="hero-slide-img" />
                            <div class="hero-slide-gradient-overlay"></div>
                            
                            <!-- Slide Badge & Caption -->
                            <div class="hero-slide-caption">
                                <span class="hero-slide-tag">
                                    <i class="bi bi-stars"></i> RITUAL 0@(i + 1) / 0@(heroSlides.Count)
                                </span>
                                <h3 class="hero-slide-title">@slide.Title</h3>
                                <p class="hero-slide-desc">@slide.Tagline</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Navigation Arrow Buttons -->
                <button type="button" class="hero-slider-arrow prev-arrow" @onclick="PrevSlide" aria-label="Previous Slide">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="hero-slider-arrow next-arrow" @onclick="NextSlide" aria-label="Next Slide">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <!-- Indicator Dots & Progress Bars -->
                <div class="hero-slide-indicators">
                    @for (int i = 0; i < heroSlides.Count; i++)
                    {
                        int dotIndex = i;
                        <button type="button" class="hero-dot @(dotIndex == currentSlideIndex ? "active" : "")" 
                                @onclick="() => GoToSlide(dotIndex)" 
                                aria-label="@($"Go to slide {dotIndex + 1}")">
                            <span class="hero-dot-progress"></span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What We Offer (Services) -->
<section class="services-section" id="services">
    <div class="container-custom">
        <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px;">
            <div>
                <span class="section-tag">OUR SERVICES</span>
                <h2 class="section-title" style="margin-bottom: 0;">What We Offer</h2>
            </div>
            <a href="book" class="btn-link-arrow" style="font-size: 14px; font-weight: 700;">
                See All Services with Details &rarr;
            </a>
        </div>

        <div class="services-cards-grid">
            @foreach (var svc in SalonService.Services.Take(4))
            {
                <div class="service-card-white">
                    <div class="service-watermark-num">@svc.Number</div>
                    <h3 class="service-item-title">@svc.Name</h3>
                    <p class="service-item-desc">@svc.Description</p>
                    <div class="service-card-divider"></div>
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="service-price-from">@svc.PriceFormatted</div>
                        <a href="@($"book?select={Uri.EscapeDataString(svc.Name)}")" style="font-size: 13px; font-weight: 700; color: var(--gold-accent);">
                            Book &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

