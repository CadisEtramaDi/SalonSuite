@page "/"
@inject SalonDataService SalonService
@inject NavigationManager Navigation

<PageTitle>Salon Studio | Professional Hair Care & Styling</PageTitle>

<!-- Public Navigation Bar -->
<header class="public-navbar">
    <div class="container-custom navbar-inner">
        <a href="/" class="brand-logo">Salon Studio</a>

        <ul class="nav-menu-links">
            <li><a href="#services" class="nav-link-item">Services</a></li>
            <li><a href="#our-work" class="nav-link-item">Our Work</a></li>
            <li><a href="#team" class="nav-link-item">Team</a></li>
            <li><a href="#contact" class="nav-link-item">Contact</a></li>
        </ul>

        <div class="navbar-actions">
            <button class="btn-book-nav" @onclick='() => OpenBookingModal("")'>Book Appointment</button>
            <a href="login" class="btn-staff-nav">Staff Login</a>
        </div>
    </div>
</header>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container-custom hero-grid">
        <div class="hero-text-col">
            <h1 class="hero-title">Styling</h1>
            <p class="hero-desc">
                Experience professional hair care in a serene, minimalist environment. Our expert stylists deliver exceptional results tailored to you.
            </p>
            <div class="hero-cta-group">
                <button class="btn-primary-dark" @onclick='() => OpenBookingModal("")'>Book Now</button>
                <a href="#services" class="btn-link-arrow">View Services &rarr;</a>
            </div>

            <div class="hero-stats-row">
                <div class="stat-item-col">
                    <span class="stat-huge">15+</span>
                    <span class="stat-label-muted">Years</span>
                </div>
                <div class="stat-item-col">
                    <span class="stat-huge">8K+</span>
                    <span class="stat-label-muted">Clients</span>
                </div>
                <div class="stat-item-col">
                    <span class="stat-huge">4.9</span>
                    <span class="stat-label-muted">Rating</span>
                </div>
            </div>
        </div>

        <div class="hero-image-col">
            <div class="hero-image-wrap">
                <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=800&auto=format&fit=crop&q=80" alt="Salon styling blow dry" class="hero-img" />
            </div>
        </div>
    </div>
</section>

<!-- What We Offer (Services) -->
<section class="services-section" id="services">
    <div class="container-custom">
        <span class="section-tag">OUR SERVICES</span>
        <h2 class="section-title">What We Offer</h2>

        <div class="services-cards-grid">
            @foreach (var svc in SalonService.Services)
            {
                <div class="service-card-white">
                    <div class="service-watermark-num">@svc.Number</div>
                    <h3 class="service-item-title">@svc.Name</h3>
                    <p class="service-item-desc">@svc.Description</p>
                    <div class="service-card-divider"></div>
                    <div class="service-price-from">@svc.PriceFormatted</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Our Work Gallery -->
<section class="gallery-section" id="our-work">
    <div class="container-custom">
        <span class="section-tag">PORTFOLIO</span>
        <h2 class="section-title">Our Work</h2>

        <div class="gallery-grid">
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?w=600&auto=format&fit=crop&q=80" alt="Hair style 1" class="gallery-img" />
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=600&auto=format&fit=crop&q=80" alt="Hair style 2" class="gallery-img" />
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=600&auto=format&fit=crop&q=80" alt="Hair style 3" class="gallery-img" />
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1580618672591-eb180b1a973f?w=600&auto=format&fit=crop&q=80" alt="Hair style 4" class="gallery-img" />
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1605497788044-5a32c7078486?w=600&auto=format&fit=crop&q=80" alt="Hair style 5" class="gallery-img" />
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?w=600&auto=format&fit=crop&q=80" alt="Hair style 6" class="gallery-img" />
            </div>
        </div>
    </div>
</section>

<!-- Our Team -->
<section class="team-section" id="team">
    <div class="container-custom">
        <span class="section-tag">EXPERTS</span>
        <h2 class="section-title">Meet Our Team</h2>

        <div class="team-grid">
            @foreach (var member in SalonService.Team)
            {
                <div class="team-card">
                    <div class="team-photo-wrap">
                        <img src="@member.ImageUrl" alt="@member.Name" class="team-photo" />
                    </div>
                    <h3 class="team-name">@member.Name</h3>
                    <span class="team-role">@member.Role</span>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Us Section -->
<section class="why-us-section">
    <div class="container-custom why-us-grid">
        <div class="why-us-image-wrap">
            <img src="https://images.unsplash.com/photo-1633681926022-84c23e8cb2d6?w=800&auto=format&fit=crop&q=80" alt="Modern Salon Interior" class="why-us-img" />
        </div>

        <div class="why-us-content">
            <span class="section-tag">WHY US</span>
            <h2 class="section-title">What Makes Us Different</h2>

            <div class="why-us-features-list">
                <div class="why-feature-item">
                    <i class="bi bi-check-lg gold-check-icon"></i>
                    <div class="feature-text-block">
                        <strong>Premium Products</strong>
                        <p>Professional-grade products for beautiful results</p>
                    </div>
                </div>

                <div class="why-feature-item">
                    <i class="bi bi-check-lg gold-check-icon"></i>
                    <div class="feature-text-block">
                        <strong>Expert Stylists</strong>
                        <p>Trained and experienced professionals</p>
                    </div>
                </div>

                <div class="why-feature-item">
                    <i class="bi bi-check-lg gold-check-icon"></i>
                    <div class="feature-text-block">
                        <strong>Personalized Care</strong>
                        <p>Customized services for every client</p>
                    </div>
                </div>

                <div class="why-feature-item">
                    <i class="bi bi-check-lg gold-check-icon"></i>
                    <div class="feature-text-block">
                        <strong>Relaxing Space</strong>
                        <p>Modern, comfortable salon environment</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Packages -->
<section class="packages-section" id="packages">
    <div class="container-custom">
        <span class="section-tag">PACKAGES</span>
        <h2 class="section-title">Service Packages</h2>

        <div class="packages-grid">
            @foreach (var pkg in SalonService.Packages)
            {
                <div class="package-card @(pkg.IsPopular ? "package-popular" : "")">
                    @if (pkg.IsPopular)
                    {
                        <span class="popular-badge-gold">POPULAR</span>
                    }

                    <span class="package-tier-name">@pkg.Name</span>
                    <div class="package-price-huge">@pkg.PriceFormatted</div>

                    <ul class="package-features-list">
                        @foreach (var f in pkg.Features)
                        {
                            <li class="package-feature-item">
                                <span class="feature-dot"></span>
                                <span>@f</span>
                            </li>
                        }
                    </ul>

                    <button class="btn-select-package" @onclick='() => OpenBookingModal(pkg.Name)'>
                        Select Package
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<!-- Client Reviews (Testimonials) -->
<section class="testimonials-section">
    <div class="container-custom">
        <span class="section-tag">TESTIMONIALS</span>
        <h2 class="section-title">Client Reviews</h2>

        <div class="reviews-grid">
            @foreach (var review in SalonService.Reviews)
            {
                <div class="review-card">
                    <div class="stars-row">
                        @for (int i = 0; i < review.Rating; i++)
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                    </div>
                    <p class="review-quote">"@review.Quote"</p>
                    <span class="review-author">@review.Author</span>
                </div>
            }
        </div>
    </div>
</section>

<!-- Editorial Dark Footer -->
<footer class="editorial-footer" id="contact">
    <div class="container-custom">
        <div class="footer-top-grid">
            <div class="footer-brand-col">
                <h3 class="footer-brand-title">Salon Studio</h3>
                <p class="footer-brand-desc">
                    A modern, premium hair salon dedicated to expert treatments, personalized styling, and a relaxing experience.
                </p>
                <div class="footer-social-links">
                    <a href="https://instagram.com" target="_blank" class="social-code-link">IG</a>
                    <a href="https://facebook.com" target="_blank" class="social-code-link">FB</a>
                    <a href="https://twitter.com" target="_blank" class="social-code-link">TW</a>
                    <a href="https://youtube.com" target="_blank" class="social-code-link">YT</a>
                </div>
            </div>

            <div class="footer-nav-col">
                <h4 class="footer-col-heading">SERVICES</h4>
                <ul class="footer-nav-list">
                    <li><a href="#services" class="footer-nav-link">Haircut</a></li>
                    <li><a href="#services" class="footer-nav-link">Color</a></li>
                    <li><a href="#services" class="footer-nav-link">Styling</a></li>
                    <li><a href="#services" class="footer-nav-link">Treatment</a></li>
                    <li><a href="#packages" class="footer-nav-link">Packages</a></li>
                </ul>
            </div>

            <div class="footer-contact-col">
                <h4 class="footer-col-heading">CONTACT</h4>
                <div class="footer-contact-info">
                    <span>123 Bonifacio Ave, Taguig City</span>
                    <span>Metro Manila, Philippines</span>
                    <span>+63 917 123 4567</span>
                    <span>info@beautyhair.ph</span>
                </div>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <span>&copy; 2026 Salon Studio. All rights reserved.</span>
            <span>Mon – Sat 8:00 AM – 8:00 PM</span>
        </div>
    </div>
</footer>

<!-- Interactive Booking Modal -->
@if (showBookingModal)
{
    <div class="booking-modal-backdrop">
        <div class="booking-modal-card">
            <div class="modal-title-row">
                <h3 class="modal-h3">Book an Appointment</h3>
                <button class="btn-close-modal" @onclick="() => showBookingModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (bookingConfirmed)
            {
                <div class="alert-confirmed-booking">
                    <strong>Thank you, @newAppt.ClientName!</strong>
                    <p>Your appointment for <strong>@newAppt.ServiceName</strong> with <strong>@newAppt.StylistName</strong> on <strong>@newAppt.Date.ToString("MMMM dd, yyyy") at @newAppt.TimeSlot</strong> has been scheduled.</p>
                </div>
            }

            <div class="booking-form-grid">
                <div class="form-full">
                    <label class="booking-label">Selected Service / Package</label>
                    <select class="booking-input" @bind="newAppt.ServiceName" @bind:after="OnServiceSelectionChanged">
                        <optgroup label="✨ Service Packages">
                            @foreach (var pkg in SalonService.Packages)
                            {
                                <option value="@($"{pkg.Name} Package")">@pkg.Name Package</option>
                            }
                        </optgroup>
                        <optgroup label="✂️ Individual Services">
                            @foreach (var svc in SalonService.Services)
                            {
                                <option value="@($"{svc.Number} {svc.Name}")">@svc.Number @svc.Name</option>
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="form-group">
                    <label class="booking-label">Preferred Specialist</label>
                    <select class="booking-input" @bind="newAppt.StylistName">
                        @foreach (var team in SalonService.Team)
                        {
                            <option value="@team.Name">@team.Name (@team.Role)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="booking-label">Appointment Date</label>
                    <input type="date" class="booking-input" @bind="newAppt.Date" />
                </div>

                <div class="form-group">
                    <label class="booking-label">Time Slot</label>
                    <select class="booking-input" @bind="newAppt.TimeSlot">
                        <option value="09:00 AM">09:00 AM</option>
                        <option value="10:30 AM">10:30 AM</option>
                        <option value="01:00 PM">01:00 PM</option>
                        <option value="02:30 PM">02:30 PM</option>
                        <option value="04:00 PM">04:00 PM</option>
                        <option value="05:30 PM">05:30 PM</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="booking-label">Your Full Name</label>
                    <input type="text" class="booking-input" placeholder="e.g. Maria Santos" @bind="newAppt.ClientName" />
                </div>

                <div class="form-group">
                    <label class="booking-label">Mobile Number</label>
                    <input type="tel" class="booking-input" placeholder="+63 917 000 0000" @bind="newAppt.ClientPhone" />
                </div>

                <div class="form-group">
                    <label class="booking-label">Email Address</label>
                    <input type="email" class="booking-input" placeholder="you@example.com" @bind="newAppt.ClientEmail" />
                </div>
            </div>

            <button class="btn-primary-dark" style="width: 100%; justify-content: center;" @onclick="ConfirmBooking" disabled="@(string.IsNullOrWhiteSpace(newAppt.ClientName))">
                Confirm Reservation
            </button>
        </div>
    </div>
}

@code {
    private bool showBookingModal = false;
    private bool bookingConfirmed = false;
    private AppointmentRecord newAppt = new();

    private void OpenBookingModal(string initialServiceName)
    {
        bookingConfirmed = false;
        var resolvedService = ResolveServiceSelection(initialServiceName);
        newAppt = new AppointmentRecord
        {
            ServiceName = resolvedService,
            StylistName = SalonService.Team.FirstOrDefault()?.Name ?? "Sofia Martinez",
            Date = DateTime.Today.AddDays(1),
            TimeSlot = "10:30 AM",
            Price = GetPriceForSelectedService(resolvedService),
            Status = "Confirmed"
        };
        showBookingModal = true;
    }

    private string ResolveServiceSelection(string? inputName)
    {
        if (string.IsNullOrWhiteSpace(inputName))
        {
            return "Signature Package";
        }

        var matchedPkg = SalonService.Packages.FirstOrDefault(p =>
            p.Name.Equals(inputName, StringComparison.OrdinalIgnoreCase) ||
            $"{p.Name} Package".Equals(inputName, StringComparison.OrdinalIgnoreCase) ||
            inputName.Contains(p.Name, StringComparison.OrdinalIgnoreCase));
        if (matchedPkg != null)
        {
            return $"{matchedPkg.Name} Package";
        }

        var matchedSvc = SalonService.Services.FirstOrDefault(s =>
            s.Name.Equals(inputName, StringComparison.OrdinalIgnoreCase) ||
            $"{s.Number} {s.Name}".Equals(inputName, StringComparison.OrdinalIgnoreCase) ||
            inputName.Contains(s.Name, StringComparison.OrdinalIgnoreCase));
        if (matchedSvc != null)
        {
            return $"{matchedSvc.Number} {matchedSvc.Name}";
        }

        return "Signature Package";
    }

    private decimal GetPriceForSelectedService(string serviceName)
    {
        var matchedPkg = SalonService.Packages.FirstOrDefault(p =>
            serviceName.Contains(p.Name, StringComparison.OrdinalIgnoreCase));
        if (matchedPkg != null) return matchedPkg.Price;

        var matchedSvc = SalonService.Services.FirstOrDefault(s =>
            serviceName.Contains(s.Name, StringComparison.OrdinalIgnoreCase));
        if (matchedSvc != null) return matchedSvc.Price;

        return 1990;
    }

    private void OnServiceSelectionChanged()
    {
        newAppt.Price = GetPriceForSelectedService(newAppt.ServiceName);
    }

    private void ConfirmBooking()
    {
        if (string.IsNullOrWhiteSpace(newAppt.ClientName)) return;

        SalonService.AddAppointment(newAppt);
        bookingConfirmed = true;

        Task.Delay(1400).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                showBookingModal = false;
                StateHasChanged();
            });
        });
    }
}
