                <div class="form-group">
                    <label class="booking-label">Contact Person</label>
                    <input type="text" class="booking-input" placeholder="e.g. Sarah Jenkins" @bind="supForm.ContactPerson" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Phone Number</label>
                    <input type="tel" class="booking-input" placeholder="+63 917 000 0000" @bind="supForm.Phone" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Email</label>
                    <input type="email" class="booking-input" placeholder="orders@supplier.ph" @bind="supForm.Email" />
