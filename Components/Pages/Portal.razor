            <div class="booking-form-grid">
                <div class="form-group">
                    <label class="booking-label">Promo Code</label>
                    <input type="text" class="booking-input" placeholder="e.g. BEAUTY20" @bind="promoForm.Code" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Discount Type</label>
                    <select class="booking-input" @bind="promoForm.DiscountType">
                        <option value="Percentage">Percentage (% OFF)</option>
                        <option value="Fixed">Fixed Amount (₱ OFF)</option>
