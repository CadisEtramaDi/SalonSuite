<!-- Modal: Add Staff Member & Login Credentials -->
@if (showNewStaffModal)
{
    <div class="booking-modal-backdrop" @onclick="() => showNewStaffModal = false">
        <div class="booking-modal-card" style="max-width: 580px;" @onclick:stopPropagation>
            <div class="modal-title-row">
                <div>
                    <h3 class="modal-h3">Provision Staff & Login Credentials</h3>
                    <span style="font-size: 12.5px; color: var(--text-muted);">Create staff profile and assign portal login credentials</span>
                </div>
                <button class="btn-close-modal" @onclick="() => showNewStaffModal = false"><i class="bi bi-x-lg"></i></button>
            </div>

            @if (!string.IsNullOrEmpty(staffModalError))
            {
                <div style="background: #FEF2F2; border: 1px solid #FECACA; color: #B91C1C; padding: 10px 14px; border-radius: 4px; font-size: 13px; margin-bottom: 14px;">
                    <i class="bi bi-exclamation-triangle-fill"></i> @staffModalError
                </div>
            }

            <div class="booking-form-grid">
                <div class="form-full">
                    <label class="booking-label">Staff Full Name</label>
                    <input type="text" class="booking-input" placeholder="e.g. Clara Santos" @bind="newStaff.Name" />
                </div>

                <div class="form-group">
                    <label class="booking-label">System Role & Portal Assignment</label>
                    <select class="booking-input" @bind="newStaff.Role">
                        <option value="Senior Stylist">Senior Stylist (Stylist Suite /employee)</option>
                        <option value="Color Specialist">Color Specialist (Stylist Suite /employee)</option>
                        <option value="Creative Director">Creative Director (Stylist Suite /employee)</option>
                        <option value="Junior Stylist">Junior Stylist (Stylist Suite /employee)</option>
                        <option value="Front Desk Cashier">Front Desk Cashier (POS Register /cashier)</option>
                        <option value="Salon Manager">Salon Manager (Management ERP /admin)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="booking-label">Contact Phone</label>
                    <input type="tel" class="booking-input" placeholder="+63 917 000 0000" @bind="newStaff.Phone" />
                </div>

                <div class="form-group">
                    <label class="booking-label">Specialization / Expertise</label>
                    <input type="text" class="booking-input" placeholder="e.g. Front Desk POS & Billing" @bind="newStaff.Specialization" />
                </div>

                <div class="form-group">
                    <label class="booking-label">Commission Rate (%)</label>
                    <input type="number" class="booking-input" value="@((int)(newStaff.CommissionRate * 100))" @onchange="@((ChangeEventArgs e) => newStaff.CommissionRate = decimal.Parse(e.Value?.ToString() ?? "25") / 100m)" />
                </div>

                <!-- Account Credentials Panel -->
                <div class="form-full" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 14px; border-radius: 6px; margin-top: 4px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                        <label style="font-size: 13.5px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 6px; margin: 0; cursor: pointer;">
                            <input type="checkbox" @bind="createLoginAccount" style="width: 16px; height: 16px; accent-color: var(--gold-accent);" />
                            <span>Create Portal Login Credentials</span>
                        </label>
                        <span style="font-size: 11px; background: #DBEAFE; color: #1E40AF; padding: 2px 6px; border-radius: 4px; font-weight: 700;">
                            <i class="bi bi-shield-check"></i> Firebase & Session
                        </span>
                    </div>

                    @if (createLoginAccount)
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px;">
                            <div>
                                <label class="booking-label" style="font-size: 12px;">Login Work Email</label>
                                <input type="email" class="booking-input" style="font-size: 13px;" placeholder="e.g. clara.cashier@beautyhair.com" @bind="staffEmailInput" />
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label class="booking-label" style="font-size: 12px; margin: 0;">Initial Password</label>
                                    <button type="button" style="background: none; border: none; font-size: 11px; color: #2563EB; font-weight: 700; cursor: pointer; padding: 0;" @onclick="GenerateRandomPassword">
                                        <i class="bi bi-magic"></i> Generate
                                    </button>
                                </div>
                                <div style="position: relative;">
                                    <input type="@(showStaffPassword ? "text" : "password")" class="booking-input" style="font-size: 13px; padding-right: 36px;" placeholder="•••••••• (min 6 chars)" @bind="staffPasswordInput" />
                                    <button type="button" @onclick="() => showStaffPassword = !showStaffPassword" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #9CA3AF; cursor: pointer; font-size: 14px;">
                                        <i class="bi @(showStaffPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top: 10px; font-size: 12px; color: #475569; display: flex; align-items: center; gap: 6px; background: #FFFFFF; padding: 8px 10px; border-radius: 4px; border: 1px solid #E2E8F0;">
                            <i class="bi bi-info-circle-fill" style="color: #3B82F6;"></i>
                            <span>
                                Portal Destination: 
                                <strong>
                                    @(newStaff.Role.Contains("Cashier") ? "Front Desk POS (/cashier)" : 
                                      newStaff.Role.Contains("Manager") ? "Management ERP (/admin)" : 
                                      "Stylist Suite (/employee)")
                                </strong>
                            </span>
                        </div>
                    }
                </div>

                <div class="form-full">
                    <label class="booking-label">Avatar Photo URL (Optional)</label>
                    <input type="text" class="booking-input" placeholder="https://images.unsplash.com/..." @bind="newStaff.ImageUrl" />
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 16px;">
                <button class="btn-primary-dark" style="flex: 1; justify-content: center; background: #E5E7EB; color: #374151;" @onclick="() => showNewStaffModal = false">
                    Cancel
                </button>
                <button class="btn-primary-dark" style="flex: 2; justify-content: center;" @onclick="SaveNewStaff" disabled="@(string.IsNullOrWhiteSpace(newStaff.Name) || isCreatingStaffAccount)">
                    @if (isCreatingStaffAccount)
                    {
                        <span><i class="bi bi-arrow-repeat spin"></i> Creating account in Firebase...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-check-lg"></i> Provision Staff & Credentials</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

