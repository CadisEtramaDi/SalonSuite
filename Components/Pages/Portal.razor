        <div class="booking-modal-card">
            <div class="modal-title-row">
                <h3 class="modal-h3">Add Vendor / Supplier</h3>
                <button class="btn-close-modal" @onclick="() => showSupplierModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="booking-form-grid">
                <div class="form-full">
                    <label class="booking-label">Company Name</label>
                    <input type="text" class="booking-input" placeholder="e.g. Wella Professional PH" @bind="supForm.CompanyName" />
