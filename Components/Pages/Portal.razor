                    <input type="number" class="booking-input" @bind="prodForm.CostPrice" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Retail Price (₱)</label>
                    <input type="number" class="booking-input" @bind="prodForm.RetailPrice" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Opening Stock Quantity</label>
                    <input type="number" class="booking-input" @bind="prodForm.StockQuantity" />
                </div>
                <div class="form-group">
                    <label class="booking-label">Reorder Alert Level</label>
                    <input type="number" class="booking-input" @bind="prodForm.ReorderLevel" />
                </div>
            </div>
            <button class="btn-primary-dark" style="width: 100%; justify-content: center; margin-top: 14px;" @onclick="SaveProduct" disabled="@(string.IsNullOrWhiteSpace(prodForm.Name))">
                Save Product
            </button>
        </div>
    </div>
}

<!-- Modal: Add Supplier -->
@if (showSupplierModal)
{
