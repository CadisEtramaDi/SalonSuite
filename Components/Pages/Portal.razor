}

<!-- Modal: New Promo Code -->
@if (showPromoModal)
{
    <div class="booking-modal-backdrop">
        <div class="booking-modal-card">
            <div class="modal-title-row">
                <h3 class="modal-h3">Create Promo Voucher</h3>
                <button class="btn-close-modal" @onclick="() => showPromoModal = false"><i class="bi bi-x-lg"></i></button>
