@page "/book"
@page "/services-packages"
@page "/booking"

<PageTitle>Bespoke Packages & Services | Salon Studio</PageTitle>

<!-- Public Navigation Bar -->
<header class="public-navbar">
    <div class="container-custom navbar-inner">
        <a href="/" class="brand-logo">
            <img src="images/logo.png" alt="Beauty Hair Logo" class="brand-logo-img" />
            <span style="letter-spacing: -0.03em;">Beauty Hair</span>
        </a>

        <ul class="nav-menu-links">
            <li><a href="/" class="nav-link-item">Home</a></li>
            <li><a href="book#packages-section" class="nav-link-item @(selectedCategory == "Packages" ? "active-nav-link" : "")" @onclick='() => SetCategory("Packages")'>Packages</a></li>
            <li><a href="book#services-section" class="nav-link-item @(selectedCategory != "Packages" && selectedCategory != "All" ? "active-nav-link" : "")" @onclick='() => SetCategory("All")'>Services</a></li>
            <li><a href="loyalty" class="nav-link-item">Loyalty & Rewards</a></li>
            <li><a href="/#our-work" class="nav-link-item">Portfolio</a></li>
            <li><a href="/#team" class="nav-link-item">Stylists</a></li>
        </ul>

        <div class="navbar-actions">
            <button class="btn-book-nav active-btn-nav" @onclick='() => OpenBookingModal("")'>
                <i class="bi bi-calendar2-check"></i> Book Now
            </button>
            @if (SalonService.CurrentUser.IsLoggedIn)
            {
                @if (SalonService.CurrentUser.Role.Contains("Admin") || SalonService.CurrentUser.Role.Contains("Manager") || SalonService.CurrentUser.Role.Contains("Owner"))
                {
                    <a href="admin" class="btn-staff-nav" style="background: var(--gold-accent); color: #000; font-weight: 700;">
                        <i class="bi bi-shield-lock-fill"></i> Admin ERP
                    </a>
                }
                else if (SalonService.CurrentUser.Role.Contains("Cashier"))
                {
                    <a href="cashier" class="btn-staff-nav" style="background: #FBBF24; color: #000; font-weight: 700;">
                        <i class="bi bi-receipt"></i> Cashier POS
                    </a>
                }
                else if (SalonService.CurrentUser.Role.Contains("Stylist"))
                {
                    <a href="employee" class="btn-staff-nav" style="background: #3B82F6; color: #FFF; font-weight: 700;">
                        <i class="bi bi-scissors"></i> Stylist Suite
                    </a>
                }
                else
                {
                    <a href="client-portal" class="btn-staff-nav" style="background: #10B981; color: #FFF; font-weight: 700;">
                        <i class="bi bi-stars"></i> VIP Loyalty
                    </a>
                }
                <button class="btn-staff-nav" @onclick="HandleLogout" title="Sign Out">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            }
            else
            {
                <a href="login" class="btn-staff-nav">
                    <i class="bi bi-person-circle"></i> Login
                </a>
            <button class="mobile-nav-toggle" @onclick="() => isMobileNavOpen = !isMobileNavOpen" aria-label="Toggle navigation menu">
                <i class="bi @(isMobileNavOpen ? "bi-x-lg" : "bi-list")"></i>
            </button>
        </div>
    </div>
</header>

@if (isMobileNavOpen)
{
    <div class="mobile-nav-drawer" @onclick="() => isMobileNavOpen = false">
        <div class="mobile-nav-drawer-content" @onclick:stopPropagation>
            <a href="/" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-house"></i> Home</a>
            <a href="book" class="mobile-nav-link active-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-scissors"></i> Packages & Services</a>
            <a href="loyalty" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-stars"></i> Loyalty & Rewards</a>
            <a href="/#our-work" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-images"></i> Portfolio & Work</a>
            <a href="/#team" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-people"></i> Stylists & Specialists</a>
            <a href="/#contact" class="mobile-nav-link" @onclick="() => isMobileNavOpen = false"><i class="bi bi-geo-alt"></i> Contact & Location</a>
            <div class="mobile-nav-divider"></div>
            <button class="btn-book-nav" style="justify-content: center; width: 100%;" @onclick='() => { isMobileNavOpen = false; OpenBookingModal(""); }'>
                <i class="bi bi-calendar2-check"></i> Book Now
            </button>
            @if (SalonService.CurrentUser.IsLoggedIn)
            {
                <button class="btn-staff-nav" style="justify-content: center; width: 100%; text-align: center; margin-top: 8px;" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i> Logout (@SalonService.CurrentUser.Name)
                </button>
            }
            else
            {
                <a href="login" class="btn-staff-nav" style="justify-content: center; width: 100%; text-align: center; margin-top: 8px;" @onclick="() => isMobileNavOpen = false">
                    <i class="bi bi-person-circle"></i> Login / Register
                </a>
            }
        </div>
    </div>
}

<!-- Catalog Hero Banner -->
<section class="catalog-hero-section">
    <div class="container-custom catalog-hero-inner">
        <div class="catalog-hero-text">
            <div class="badge-gold-pill">
                <i class="bi bi-stars"></i> BESPOKE MENU & PACKAGES
            </div>
            <h1 class="catalog-page-title">Curated Packages & Hair Care Rituals</h1>
            <p class="catalog-page-desc">
                Immerse yourself in precision craftsmanship, high-end organic formulations, and transformative hair artistry. Browse our signature multi-service packages or choose an individualized ritual.
            </p>

            <div class="catalog-highlights-row">
                <div class="highlight-chip">
                    <i class="bi bi-award-fill"></i>
                    <span>Master Colorists & Stylists</span>
                </div>
                <div class="highlight-chip">
                    <i class="bi bi-gem"></i>
                    <span>Luxury European Products</span>
                </div>
                <div class="highlight-chip">
                    <i class="bi bi-shield-check"></i>
                    <span>Instant Online Confirmation</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Search Bar Section -->
<section class="catalog-controls-section">
    <div class="container-custom">
        <div class="catalog-controls-bar">
            <!-- Category Tabs -->
            <div class="catalog-category-tabs">
                <button class="cat-tab-btn @(selectedCategory == "All" ? "active" : "")" @onclick='() => SetCategory("All")'>
                    <i class="bi bi-grid-fill"></i> All (@(SalonService.Packages.Count + SalonService.Services.Count))
                </button>
                <button class="cat-tab-btn @(selectedCategory == "Packages" ? "active" : "")" @onclick='() => SetCategory("Packages")'>
                    <i class="bi bi-box2-heart-fill"></i> Packages (@SalonService.Packages.Count)
                </button>
                <button class="cat-tab-btn @(selectedCategory == "Hair" ? "active" : "")" @onclick='() => SetCategory("Hair")'>
                    <i class="bi bi-scissors"></i> Haircut & Blowout
                </button>
                <button class="cat-tab-btn @(selectedCategory == "Color" ? "active" : "")" @onclick='() => SetCategory("Color")'>
                    <i class="bi bi-palette-fill"></i> Color & Balayage
                </button>
                <button class="cat-tab-btn @(selectedCategory == "Treatment" ? "active" : "")" @onclick='() => SetCategory("Treatment")'>
                    <i class="bi bi-droplet-half"></i> Keratin & Treatments
                </button>
                <button class="cat-tab-btn @(selectedCategory == "Spa" ? "active" : "")" @onclick='() => SetCategory("Spa")'>
                    <i class="bi bi-flower1"></i> Head Spa
                </button>
            </div>

            <!-- Search & Sort Controls -->
            <div class="catalog-search-sort-wrap">
                <div class="search-input-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" 
                           placeholder="Search packages, cuts, balayage..." 
                           class="catalog-search-input" 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn-clear-search" @onclick='() => searchTerm = ""'>
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                <div class="sort-select-box">
                    <select class="catalog-sort-select" @bind="sortBy">
                        <option value="featured">Featured / Popular</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="duration">Shortest Duration</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Catalog Container -->
<main class="catalog-main-content">
    <div class="container-custom">

        <!-- 1. PACKAGES SECTION -->
        @if (FilteredPackages.Any())
        {
            <div class="catalog-section-group" id="packages-section">
                <div class="section-header-row">
                    <div>
                        <span class="section-tag">ALL-INCLUSIVE EXPERIENCES</span>
                        <h2 class="catalog-section-title">Signature Service Packages</h2>
                    </div>
                    <span class="results-count-badge">@FilteredPackages.Count @(FilteredPackages.Count == 1 ? "Package" : "Packages")</span>
                </div>

                <div class="packages-cards-grid">
                    @foreach (var pkg in FilteredPackages)
                    {
                        <div class="pkg-card-luxury @(pkg.IsPopular ? "popular-card" : "")">
                            <!-- Card Image Wrap -->
                            <div class="card-photo-header">
                                <img src="@pkg.ImageUrl" alt="@pkg.Name Package" class="card-header-img" loading="lazy" />
                                <div class="card-img-overlay"></div>
                                
                                @if (pkg.IsPopular)
                                {
                                    <span class="card-badge-popular">
                                        <i class="bi bi-star-fill"></i> MOST POPULAR
                                    </span>
                                }

                                <div class="card-duration-tag">
                                    <i class="bi bi-clock-history"></i> @pkg.DurationMinutes mins
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="pkg-card-body">
                                <div class="pkg-header-row">
                                    <div>
                                        <span class="card-category-sub">ALL-IN-ONE BUNDLE</span>
                                        <h3 class="pkg-card-title">@pkg.Name Package</h3>
                                    </div>
                                    <div class="pkg-price-display">
                                        <span class="price-val">@pkg.PriceFormatted</span>
                                    </div>
                                </div>

                                <p class="pkg-card-desc">
                                    @pkg.Description
                                </p>

                                <div class="pkg-divider"></div>

                                <div class="pkg-included-label">
                                    <i class="bi bi-check2-all"></i> INCLUDED IN THIS PACKAGE:
                                </div>

                                <ul class="pkg-features-list">
                                    @foreach (var feat in pkg.Features)
                                    {
                                        <li class="pkg-feat-item">
                                            <span class="feat-icon-check"><i class="bi bi-check"></i></span>
                                            <span>@feat</span>
                                        </li>
                                    }
                                </ul>

                                <div class="pkg-card-footer">
                                    <button class="btn-book-card-primary" @onclick='() => OpenBookingModal(pkg.Name)'>
                                        <span>Book This Package</span>
                                        <i class="bi bi-arrow-right-short"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 2. INDIVIDUAL SERVICES SECTION -->
        @if (FilteredServices.Any())
        {
            <div class="catalog-section-group" id="services-section">
                <div class="section-header-row">
                    <div>
                        <span class="section-tag">INDIVIDUAL RITUALS</span>
                        <h2 class="catalog-section-title">Bespoke Hair & Spa Services</h2>
                    </div>
                    <span class="results-count-badge">@FilteredServices.Count @(FilteredServices.Count == 1 ? "Service" : "Services")</span>
                </div>

                <div class="services-cards-grid-modern">
                    @foreach (var svc in FilteredServices)
                    {
                        <div class="svc-card-luxury">
                            <!-- Card Image -->
                            <div class="svc-card-image-wrap">
                                <img src="@svc.ImageUrl" alt="@svc.Name" class="svc-card-img" loading="lazy" />
                                <span class="svc-watermark-pill">@svc.Number</span>
                                <span class="svc-category-badge cat-@svc.Category.ToLower()">@svc.Category</span>
                            </div>

                            <!-- Card Content -->
                            <div class="svc-card-content">
                                <div class="svc-meta-row">
                                    <span class="svc-duration-pill">
                                        <i class="bi bi-stopwatch"></i> @svc.DurationMinutes mins
                                    </span>
                                    <span class="svc-price-pill">@svc.PriceFormatted</span>
                                </div>

                                <h3 class="svc-card-title">@svc.Name</h3>
                                <p class="svc-card-description">@svc.Description</p>

                                <div class="svc-card-footer">
                                    <button class="btn-book-service" @onclick='() => OpenBookingModal(svc.Name)'>
                                        <i class="bi bi-calendar-plus"></i>
                                        <span>Book Service</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Empty State -->
        @if (!FilteredPackages.Any() && !FilteredServices.Any())
        {
            <div class="catalog-empty-state">
                <div class="empty-icon-circle">
                    <i class="bi bi-search"></i>
                </div>
                <h3 class="empty-title">No offerings found</h3>
                <p class="empty-desc">We couldn't find any packages or services matching "<strong>@searchTerm</strong>". Try clearing your search or picking another category.</p>
                <button class="btn-primary-dark" @onclick="ResetFilters">
                    <i class="bi bi-arrow-clockwise"></i> Reset Filters
                </button>
            </div>
        }

    </div>
</main>

<!-- Bottom Reassurance Strip -->
<section class="reassurance-strip">
    <div class="container-custom">
        <div class="reassurance-grid">
            <div class="reassurance-item">
                <div class="reassurance-icon"><i class="bi bi-clock-history"></i></div>
                <div>
                    <h4 class="reassurance-title">Flexible Scheduling</h4>
                    <p class="reassurance-text">Effortlessly reschedule up to 24 hours prior to appointment.</p>
                </div>
            </div>
            <div class="reassurance-item">
                <div class="reassurance-icon"><i class="bi bi-sparkles"></i></div>
                <div>
                    <h4 class="reassurance-title">Clean & Sanitized</h4>
                    <p class="reassurance-text">Hospital-grade sterilization for all tools and private stations.</p>
                </div>
            </div>
            <div class="reassurance-item">
                <div class="reassurance-icon"><i class="bi bi-heart-pulse"></i></div>
                <div>
                    <h4 class="reassurance-title">Satisfaction Guaranteed</h4>
                    <p class="reassurance-text">Tailored consultations to ensure you adore your final look.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Editorial Dark Footer -->
<footer class="editorial-footer" id="contact">
    <div class="container-custom">
        <div class="footer-top-grid">
            <div class="footer-brand-col">
                <img src="images/logo.png" alt="Beauty Hair" class="footer-logo-img" />
                <h3 class="footer-brand-title">Beauty Hair</h3>
                <p class="footer-brand-desc">
                    A modern, premium hair salon dedicated to expert treatments, personalized styling, and an elevated client experience.
                </p>
                <div class="footer-social-links">
                    <a href="https://instagram.com" target="_blank" class="social-code-link">IG</a>
                    <a href="https://facebook.com" target="_blank" class="social-code-link">FB</a>
                    <a href="https://twitter.com" target="_blank" class="social-code-link">TW</a>
                    <a href="https://youtube.com" target="_blank" class="social-code-link">YT</a>
                </div>
            </div>

            <div class="footer-nav-col">
                <h4 class="footer-col-heading">NAVIGATION</h4>
                <ul class="footer-nav-list">
                    <li><a href="/" class="footer-nav-link">Home</a></li>
                    <li><a href="book" class="footer-nav-link">Book Appointment</a></li>
                    <li><a href="/#our-work" class="footer-nav-link">Portfolio</a></li>
                    <li><a href="/#team" class="footer-nav-link">Meet the Team</a></li>
                    <li><a href="login" class="footer-nav-link">Client / Staff Login</a></li>
                </ul>
            </div>

            <div class="footer-contact-col">
                <h4 class="footer-col-heading">LOCATION & HOURS</h4>
                <div class="footer-contact-info">
                    <span>123 Bonifacio Ave, Taguig City</span>
                    <span>Metro Manila, Philippines</span>
                    <span>+63 917 123 4567</span>
                    <span>Mon – Sat: 8:00 AM – 8:00 PM</span>
                </div>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <span>&copy; 2026 Salon Studio. All rights reserved.</span>
            <span>Crafted for Luxury Hair Care</span>
        </div>
    </div>
</footer>

<!-- Customer Authentication Required Modal Dialog -->
@if (showLoginRequiredModal)
{
    <div class="booking-modal-backdrop" @onclick="() => showLoginRequiredModal = false">
        <div class="booking-modal-card modern-booking-card auth-required-modal-card" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="modal-title-row">
                <div>
                    <span class="booking-modal-eyebrow" style="color: #D97706;">
                        <i class="bi bi-shield-lock-fill"></i> CLIENT AUTHENTICATION
                    </span>
                    <h3 class="modal-h3">Please Sign In to Book</h3>
                </div>
                <button class="btn-close-modal" @onclick="() => showLoginRequiredModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <p class="auth-prompt-desc">
                To reserve your appointment slot and link your booking to your VIP rewards & points, please sign in to your account or create a new one.
            </p>

            @if (!string.IsNullOrWhiteSpace(pendingBookingService))
            {
                <div class="pending-service-strip">
                    <div class="pending-svc-icon"><i class="bi bi-stars"></i></div>
                    <div class="pending-svc-text">
                        <span class="pending-svc-label">Pending Reservation</span>
                        <span class="pending-svc-name">@pendingBookingService</span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(authErrorMessage))
            {
                <div class="auth-error-box">
                    <i class="bi bi-exclamation-circle-fill"></i> @authErrorMessage
                </div>
            }

            @if (authRegisterSuccess)
            {
                <div class="auth-success-box">
                    <i class="bi bi-check-circle-fill"></i> Account authenticated! Preparing your reservation...
                </div>
            }

            <!-- Auth Mode Toggle Tabs -->
            <div class="auth-modal-tabs">
                <button type="button" class="auth-tab-btn @(!isAuthRegisterMode ? "active" : "")" @onclick="() => SwitchAuthMode(false)">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
                <button type="button" class="auth-tab-btn @(isAuthRegisterMode ? "active" : "")" @onclick="() => SwitchAuthMode(true)">
                    <i class="bi bi-person-plus-fill"></i> Create Account
                </button>
            </div>

            @if (!isAuthRegisterMode)
            {
                <!-- Sign In Form -->
                <form @onsubmit="HandleModalLogin" @onsubmit:preventDefault class="auth-modal-form">
                    <div class="login-field-group">
                        <label class="login-field-label">Email Address</label>
                        <input type="email" class="login-input-text" placeholder="you@gmail.com" @bind="authEmail" required />
                    </div>

                    <div class="login-field-group">
                        <label class="login-field-label">Password</label>
                        <div style="position: relative;">
                            <input type="@(showAuthPassword ? "text" : "password")" class="login-input-text" style="width: 100%; padding-right: 40px;" placeholder="••••••••" @bind="authPassword" required />
                            <button type="button" @onclick="() => showAuthPassword = !showAuthPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #9CA3AF; font-size: 15px; cursor: pointer;">
                                <i class="bi @(showAuthPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-dark" style="width: 100%; justify-content: center; padding: 12px; font-weight: 700; margin-top: 6px;" disabled="@isAuthenticating">
                        @if (isAuthenticating)
                        {
                            <span><i class="bi bi-arrow-repeat spin"></i> Verifying credentials...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-circle"></i> Sign In & Continue Booking</span>
                        }
                    </button>
                </form>
            }
            else
            {
                <!-- Register Form -->
                <form @onsubmit="HandleModalRegister" @onsubmit:preventDefault class="auth-modal-form">
                    <div class="login-field-group">
                        <label class="login-field-label">Full Name <span style="color: #DC2626;">*</span></label>
                        <input type="text" class="login-input-text" placeholder="e.g. Maria Santos" @bind="authFullName" required />
                    </div>

                    <div class="login-field-group">
                        <label class="login-field-label">Mobile Phone Number <span style="color: #DC2626;">*</span></label>
                        <input type="tel" class="login-input-text" placeholder="+63 917 000 0000" @bind="authPhone" required />
                    </div>

                    <div class="login-field-group">
                        <label class="login-field-label">Email Address <span style="color: #DC2626;">*</span></label>
                        <input type="email" class="login-input-text" placeholder="you@example.com" @bind="authEmail" required />
                    </div>

                    <div class="login-field-group">
                        <label class="login-field-label">Password <span style="color: #DC2626;">*</span></label>
                        <div style="position: relative;">
                            <input type="@(showAuthPassword ? "text" : "password")" class="login-input-text" style="width: 100%; padding-right: 40px;" placeholder="•••••••• (min 6 chars)" @bind="authPassword" required />
                            <button type="button" @onclick="() => showAuthPassword = !showAuthPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #9CA3AF; font-size: 15px; cursor: pointer;">
                                <i class="bi @(showAuthPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-dark" style="width: 100%; justify-content: center; padding: 12px; font-weight: 700; margin-top: 6px;" disabled="@isAuthenticating">
                        @if (isAuthenticating)
                        {
                            <span><i class="bi bi-arrow-repeat spin"></i> Creating account...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-person-check"></i> Create Account & Continue Booking</span>
                        }
                    </button>
                </form>
            }

            <div class="login-divider" style="margin: 16px 0;">
                <span>or</span>
            </div>

            <!-- Google One-Click Auth -->
            <button type="button" class="btn-google-signin" @onclick="HandleModalGoogleSignIn" disabled="@isAuthenticating" style="width: 100%; justify-content: center;">
                <svg class="google-icon-svg" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Continue with Google</span>
            </button>
        </div>
    </div>
}

<!-- Interactive Booking Modal Dialog -->
@if (showBookingModal)
{
    <div class="booking-modal-backdrop" @onclick="CloseBookingModalBackdrop">
        <div class="booking-modal-card modern-booking-card" @onclick:stopPropagation>
            <div class="modal-title-row">
                <div>
                    <span class="booking-modal-eyebrow">RESERVATION DESK</span>
                    <h3 class="modal-h3">Book Your Appointment</h3>
                </div>
                <button class="btn-close-modal" @onclick="CloseBookingModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (bookingCancelled)
            {
                <div class="confirmation-success-panel">
                    <div class="confirm-icon-circle" style="background: #FEF2F2; color: #DC2626; border: 2px solid #FCA5A5;">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <span style="background: #FEE2E2; color: #991B1B; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 9999px; border: 1px solid #FECACA; display: inline-block; margin-bottom: 12px;">
                        RESERVATION CANCELLED
                    </span>
                    <h3 class="confirm-title" style="color: #991B1B;">Appointment Cancelled</h3>
                    <p class="confirm-subtitle">Your reservation <strong>#APT-@newAppt.Id</strong> has been cancelled. No cancellation fees apply.</p>

                    <div class="confirm-details-box" style="border-left: 4px solid #EF4444;">
                        <div class="confirm-detail-row">
                            <span class="c-label">Booking Reference</span>
                            <span class="c-val" style="font-family: monospace;">#APT-@newAppt.Id</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Service / Package</span>
                            <span class="c-val">@newAppt.ServiceName</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Originally Scheduled</span>
                            <span class="c-val" style="color: #6B7280; text-decoration: line-through;">@newAppt.Date.ToString("MMMM dd, yyyy") at @newAppt.TimeSlot</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Status</span>
                            <span style="background: #FEE2E2; color: #991B1B; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 4px; display: inline-block;">Cancelled</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(newAppt.ClientEmail))
                    {
                        <div style="background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 18px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <i class="bi bi-envelope-x-fill" style="font-size: 16px; color: #DC2626;"></i>
                            <span>Cancellation confirmation email sent to <strong>@newAppt.ClientEmail</strong></span>
                        </div>
                    }

                    <div class="confirm-actions-row" style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <button type="button" class="btn-primary-dark" style="flex: 1; justify-content: center; min-width: 180px;" @onclick="StartNewBookingFromCancelled">
                            <i class="bi bi-calendar-plus"></i> Book Another Ritual
                        </button>
                        <button type="button" class="btn-cancel-modal" style="flex: 1; justify-content: center; min-width: 140px; border: 1px solid var(--border-light);" @onclick="CloseBookingModal">
                            <i class="bi bi-x-lg"></i> Close
                        </button>
                    </div>
                </div>
            }
            else if (isCancellingConfirmedAppt)
            {
                <div class="confirmation-success-panel">
                    <div class="confirm-icon-circle" style="background: #FEF3C7; color: #D97706; border: 2px solid #FDE68A;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <span style="background: #FEF3C7; color: #92400E; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 9999px; border: 1px solid #FDE68A; display: inline-block; margin-bottom: 12px;">
                        CONFIRM CANCELLATION
                    </span>
                    <h3 class="confirm-title">Cancel Reservation?</h3>
                    <p class="confirm-subtitle">
                        Are you sure you want to cancel your appointment for <strong>@newAppt.ServiceName</strong> on <strong>@newAppt.Date.ToString("MMM dd, yyyy") at @newAppt.TimeSlot</strong>?
                    </p>

                    @if (!string.IsNullOrEmpty(cancelErrorMessage))
                    {
                        <div class="auth-error-box" style="margin-bottom: 16px;">
                            <i class="bi bi-exclamation-circle-fill"></i> @cancelErrorMessage
                        </div>
                    }

                    <div style="background: #F9FAFB; border: 1px solid var(--border-light); border-radius: 8px; padding: 16px; margin-bottom: 20px; text-align: left;">
                        <label class="booking-label" style="margin-bottom: 6px; display: block; font-size: 12.5px;">
                            Reason for cancellation (optional):
                        </label>
                        <select class="booking-input" style="font-size: 13.5px;" @bind="cancelReason">
                            <option value="Change of schedule">Change of schedule / Conflict</option>
                            <option value="Booked incorrect date or time">Booked incorrect date or time</option>
                            <option value="Need to choose a different service">Need to choose a different service</option>
                            <option value="Personal emergency">Personal emergency</option>
                            <option value="Other reasons">Other reasons</option>
                        </select>
                    </div>

                    <div class="confirm-actions-row" style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <button type="button" class="btn-cancel-modal" style="flex: 1; justify-content: center; border: 1px solid var(--border-light); font-weight: 600;" @onclick="AbortCancelBooking" disabled="@isProcessingCancellation">
                            <i class="bi bi-arrow-left"></i> No, Keep Appointment
                        </button>
                        <button type="button" class="btn-primary-dark" style="flex: 1; justify-content: center; background: #DC2626; border-color: #DC2626; color: #FFF; font-weight: 700;" @onclick="ConfirmCancelAppointment" disabled="@isProcessingCancellation">
                            @if (isProcessingCancellation)
                            {
                                <span><i class="bi bi-arrow-repeat spin"></i> Processing...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-trash3-fill"></i> Yes, Cancel Appointment</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else if (bookingConfirmed)
            {
                <div class="confirmation-success-panel">
                    <div class="confirm-icon-circle">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <span style="background: #ECFDF5; color: #065F46; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 9999px; border: 1px solid #A7F3D0; display: inline-block; margin-bottom: 12px;">
                        RESERVATION CONFIRMED
                    </span>
                    <h3 class="confirm-title">Reservation Confirmed!</h3>
                    <p class="confirm-subtitle">Thank you, <strong>@newAppt.ClientName</strong>. We look forward to seeing you at Salon Studio.</p>

                    <div class="confirm-details-box">
                        <div class="confirm-detail-row">
                            <span class="c-label">Booking Reference</span>
                            <span class="c-val" style="font-family: monospace;">#APT-@newAppt.Id</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Service / Package</span>
                            <span class="c-val">@newAppt.ServiceName</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Specialist</span>
                            <span class="c-val">
                                @newAppt.StylistName
                                @if (wasAutoAssigned)
                                {
                                    <span style="display: inline-block; font-size: 11px; color: #059669; background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 4px; padding: 2px 7px; margin-left: 6px; font-weight: 700;">
                                        <i class="bi bi-magic"></i> Auto-Assigned
                                    </span>
                                }
                            </span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Date & Time</span>
                            <span class="c-val">@newAppt.Date.ToString("MMMM dd, yyyy") at @newAppt.TimeSlot</span>
                        </div>
                        <div class="confirm-detail-row">
                            <span class="c-label">Estimated Total</span>
                            <span class="c-val-gold">₱@newAppt.Price.ToString("N0")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(newAppt.ClientEmail))
                    {
                        <div style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 18px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <i class="bi bi-envelope-check-fill" style="font-size: 16px; color: #059669;"></i>
                            <span>Confirmation email sent to <strong>@newAppt.ClientEmail</strong></span>
                        </div>
                    }

                    <div class="confirm-actions-row" style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <a href="loyalty?appt_id=@newAppt.Id" class="btn-primary-dark" style="flex: 1.2; justify-content: center; min-width: 150px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="bi bi-calendar-check"></i> View in Loyalty Lounge
                        </a>
                        <button type="button" class="btn-cancel-appt-action" style="flex: 1; justify-content: center; min-width: 150px; padding: 11px 16px; border-radius: 8px; font-weight: 700; font-size: 13.5px; border: 1px solid #FCA5A5; background: #FEF2F2; color: #DC2626; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s;" @onclick="PromptCancelBooking">
                            <i class="bi bi-x-circle"></i> Cancel Appointment
                        </button>
                    </div>

                    <div style="text-align: center; margin-top: 14px;">
                        <span style="font-size: 12px; color: var(--text-muted);">
                            Made a mistake or changed plans? You can cancel right here or manage bookings in your <a href="loyalty?appt_id=@newAppt.Id" style="color: var(--gold-accent); text-decoration: underline; font-weight: 600;">VIP Loyalty Lounge</a>.
                        </span>
                    </div>
                </div>
            }
            else
            {
                <!-- Authenticated Customer Info Banner -->
                @if (SalonService.CurrentUser.IsLoggedIn)
                {
                    <div class="auth-user-booking-badge">
                        <div class="auth-user-booking-left">
                            <div class="auth-user-booking-avatar">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div class="auth-user-booking-info">
                                <div class="auth-user-booking-name">Booking as <strong>@SalonService.CurrentUser.Name</strong></div>
                                <div class="auth-user-booking-meta">
                                    <span>@SalonService.CurrentUser.Email</span>
                                    @if (CurrentLoggedInCustomer != null && !string.IsNullOrEmpty(CurrentLoggedInCustomer.Tier))
                                    {
                                        <span class="auth-user-tier-pill" style="background: @CurrentLoggedInCustomer.TierBadgeColor;">
                                            <i class="bi bi-gem"></i> @CurrentLoggedInCustomer.Tier Member (@CurrentLoggedInCustomer.LoyaltyPoints pts)
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <a href="login?returnUrl=@(Uri.EscapeDataString(Navigation.Uri))" class="btn-link-muted" style="font-size: 11.5px; text-decoration: underline; color: var(--text-muted);">
                            Switch
                        </a>
                    </div>
                }

                <div class="booking-form-grid">
                    <!-- Chosen Offering (Read-Only Confirmation) -->
                    <div class="form-full" style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 8px; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div style="width: 30px; height: 30px; border-radius: 50%; background: #FDE68A; color: #B45309; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                                <i class="bi bi-stars"></i>
                            </div>
                            <div>
                                <span style="font-size: 10.5px; text-transform: uppercase; font-weight: 800; color: #92400E; letter-spacing: 0.05em; display: block;">Selected Offering</span>
                                <strong style="font-size: 14.5px; color: #78350F;">@newAppt.ServiceName</strong>
                            </div>
                        </div>
                        <span style="font-size: 15px; font-weight: 800; color: #92400E;">₱@newAppt.Price.ToString("N0")</span>
                    </div>

                    <!-- Specialist Selection -->
                    <div class="form-group">
                        <label class="booking-label">
                            <i class="bi bi-person-badge"></i> Preferred Specialist <span style="font-size: 11px; font-weight: 500; color: var(--text-muted);">(Optional)</span>
                        </label>
                        <select class="booking-input" @bind="newAppt.StylistName">
                            <option value="">✨ Any Available Specialist (Auto-Assign)</option>
                            @foreach (var team in SalonService.Stylists)
                            {
                                <option value="@team.Name">@team.Name — @team.Role</option>
                            }
                        </select>
                        @if (string.IsNullOrWhiteSpace(newAppt.StylistName) || newAppt.StylistName.Contains("Any", StringComparison.OrdinalIgnoreCase))
                        {
                            <span style="display: block; font-size: 11.5px; color: #059669; margin-top: 4px; font-weight: 600;">
                                <i class="bi bi-magic"></i> We'll automatically assign the best free specialist for this slot.
                            </span>
                        }
                    </div>

                    <!-- Appointment Date -->
                    <div class="form-group">
                        <label class="booking-label">
                            <i class="bi bi-calendar-event"></i> Appointment Date
                        </label>
                        <input type="date" 
                               class="booking-input" 
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                               @bind="newAppt.Date" />
                    </div>

                    <!-- Time Slot -->
                    <div class="form-full">
                        <label class="booking-label">
                            <i class="bi bi-clock"></i> Preferred Time Slot
                        </label>
                        <div class="time-slots-picker-grid">
                            @foreach (var slot in availableTimeSlots)
                            {
                                <button type="button" 
                                        class="time-slot-btn @(newAppt.TimeSlot == slot ? "selected" : "")" 
                                        @onclick="() => newAppt.TimeSlot = slot">
                                    @slot
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Client Name -->
                    <div class="form-group">
                        <label class="booking-label" for="bookingClientName">
                            <i class="bi bi-person"></i> Full Name <span style="color: #DC2626;">*</span>
                        </label>
                        <input id="bookingClientName" name="name" type="text" autocomplete="name" class="booking-input" placeholder="e.g. Maria Santos" @bind="newAppt.ClientName" required />
                    </div>

                    <!-- Mobile Phone -->
                    <div class="form-group">
                        <label class="booking-label" for="bookingClientPhone">
                            <i class="bi bi-telephone"></i> Mobile Phone <span style="color: #DC2626;">*</span>
                        </label>
                        <input id="bookingClientPhone" name="phone" type="tel" autocomplete="tel" class="booking-input" placeholder="+63 917 000 0000" @bind="newAppt.ClientPhone" required />
                    </div>

                    <!-- Email Address -->
                    <div class="form-full">
                        <label class="booking-label" for="bookingClientEmail">
                            <i class="bi bi-envelope"></i> Email Address <span style="color: #DC2626;">*</span>
                        </label>
                        <input id="bookingClientEmail" name="email" type="email" autocomplete="email" class="booking-input" placeholder="you@example.com (for appointment receipt)" @bind="newAppt.ClientEmail" required />
                    </div>

                    <!-- Special Notes -->
                    <div class="form-full">
                        <label class="booking-label">
                            <i class="bi bi-chat-left-text"></i> Special Notes / Hair Condition (Optional)
                        </label>
                        <textarea class="booking-input" style="height: 68px; resize: vertical;" placeholder="e.g., Sensitive scalp, previous bleach treatment, bridal styling..." @bind="newAppt.Notes"></textarea>
                    </div>
                </div>

                <!-- Price Summary Box -->
                <div class="booking-summary-strip">
                    <div class="summary-left">
                        <span class="summary-label">Estimated Service Total</span>
                        <span class="summary-sub">Pay in salon via Cash, GCash, or Card at Cashier</span>
                    </div>
                    <div class="summary-price">
                        ₱@newAppt.Price.ToString("N0")
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="booking-modal-actions">
                    <button type="button" class="btn-cancel-modal" @onclick="() => showBookingModal = false">Cancel</button>
                    <button type="button" class="btn-primary-dark" style="flex: 1; justify-content: center;" 
                            @onclick="ConfirmBooking" 
                            disabled="@(string.IsNullOrWhiteSpace(newAppt.ClientName) || string.IsNullOrWhiteSpace(newAppt.ClientPhone))">
                        <i class="bi bi-check2-circle"></i> Complete Booking
                    </button>
                </div>
            }
        </div>
    </div>
}
